{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Resume NER: fine-tune DistilBERT, export to ONNX, quantise\n",
    "\n",
    "Runs on a free Colab / Kaggle T4 GPU in about 10 minutes.\n",
    "\n",
    "1. Load `data/train.jsonl` (made by `ml/generate_data.py`), split by document\n",
    "2. Fine-tune `distilbert-base-cased` for token classification (11 BIO tags)\n",
    "3. Score on the validation split with `seqeval`\n",
    "4. Export to ONNX, quantise to 8-bit, check it matches PyTorch\n",
    "5. Upload `model.onnx`, `tokenizer.json`, `labels.json` to the Hugging Face Hub\n",
    "\n",
    "The hand-checked test set is **not** used here. It is only used by `ml/evaluate.py`."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "!pip -q install \"transformers==4.47.1\" \"datasets==3.2.0\" \"seqeval==1.2.2\" \"onnx==1.17.0\" \"onnxruntime==1.20.1\" \"accelerate>=1.2\" huggingface_hub"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- settings ---\n",
    "REPO_URL = \"https://github.com/nikhilg-droid/Resume-screener.git"   # or upload data/train.jsonl by hand\n",
    "TRAIN_FILE = \"resume-screener/data/train.jsonl\"\n",
    "MODEL_NAME = \"distilbert-base-cased\"   # cased: capital letters help spot names of colleges and companies\n",
    "HF_REPO = \"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",
    "EPOCHS = 5\n",
    "LR = 5e-5\n",
    "OUT = \"resume-ner\"\n",
    "SEED = 42"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os\n",
    "if not os.path.exists(TRAIN_FILE):\n",
    "    !git clone -q {REPO_URL}\n",
    "print(os.path.exists(TRAIN_FILE))"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import json, random\n",
    "from collections import Counter\n",
    "\n",
    "# Same tag order as backend/resume_screener/text.py (TAGS)\n",
    "LABELS = [\"SKILL\", \"DEGREE\", \"COLLEGE\", \"COMPANY\", \"YEARS_EXP\"]\n",
    "TAGS = [\"O\"] + [f\"{p}-{l}\" for l in LABELS for p in (\"B\", \"I\")]\n",
    "tag2id = {t: i for i, t in enumerate(TAGS)}\n",
    "\n",
    "rows = [json.loads(l) for l in open(TRAIN_FILE, encoding=\"utf-8\") if l.strip()]\n",
    "# Split by document, so chunks of one resume never sit in both train and validation\n",
    "docs = sorted({r[\"doc_id\"] for r in rows})\n",
    "random.Random(SEED).shuffle(docs)\n",
    "val_docs = set(docs[: max(1, len(docs) // 10)])\n",
    "train_rows = [r for r in rows if r[\"doc_id\"] not in val_docs]\n",
    "val_rows = [r for r in rows if r[\"doc_id\"] in val_docs]\n",
    "print(len(rows), \"chunks |\", len(train_rows), \"train |\", len(val_rows), \"validation\")\n",
    "print(Counter(t[2:] for r in rows for t in r[\"tags\"] if t.startswith(\"B-\")))"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Tokenise and align tags to sub-words\n",
    "Only the first sub-word of each word gets the tag; the rest get -100 and are ignored by the loss. The app decodes the same way (`first_subtoken_tags`)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from datasets import Dataset\n",
    "from transformers import AutoTokenizer\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
    "\n",
    "def encode(batch):\n",
    "    enc = tokenizer(batch[\"words\"], is_split_into_words=True, truncation=True, max_length=512)\n",
    "    all_labels = []\n",
    "    for i, tags in enumerate(batch[\"tags\"]):\n",
    "        prev, labels = None, []\n",
    "        for wid in enc.word_ids(i):\n",
    "            labels.append(-100 if wid is None or wid == prev else tag2id[tags[wid]])\n",
    "            prev = wid\n",
    "        all_labels.append(labels)\n",
    "    enc[\"labels\"] = all_labels\n",
    "    return enc\n",
    "\n",
    "cols = [\"words\", \"tags\"]\n",
    "train_ds = Dataset.from_list([{k: r[k] for k in cols} for r in train_rows]).map(encode, batched=True, remove_columns=cols)\n",
    "val_ds = Dataset.from_list([{k: r[k] for k in cols} for r in val_rows]).map(encode, batched=True, remove_columns=cols)\n",
    "train_ds"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Fine-tune"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np, torch\n",
    "from seqeval.metrics import classification_report, f1_score\n",
    "from transformers import (AutoModelForTokenClassification, DataCollatorForTokenClassification,\n",
    "                          Trainer, TrainingArguments, set_seed)\n",
    "\n",
    "set_seed(SEED)\n",
    "model = AutoModelForTokenClassification.from_pretrained(\n",
    "    MODEL_NAME, num_labels=len(TAGS), id2label=dict(enumerate(TAGS)), label2id=tag2id)\n",
    "\n",
    "def to_tags(preds, labels):\n",
    "    true, pred = [], []\n",
    "    for p_row, l_row in zip(preds, labels):\n",
    "        keep = [(TAGS[p], TAGS[l]) for p, l in zip(p_row, l_row) if l != -100]\n",
    "        pred.append([p for p, _ in keep]); true.append([l for _, l in keep])\n",
    "    return true, pred\n",
    "\n",
    "def compute_metrics(eval_pred):\n",
    "    logits, labels = eval_pred\n",
    "    true, pred = to_tags(np.argmax(logits, -1), labels)\n",
    "    return {\"macro_f1\": f1_score(true, pred, average=\"macro\"), \"micro_f1\": f1_score(true, pred)}\n",
    "\n",
    "args = TrainingArguments(\n",
    "    output_dir=\"checkpoints\", num_train_epochs=EPOCHS, learning_rate=LR,\n",
    "    per_device_train_batch_size=16, per_device_eval_batch_size=32, weight_decay=0.01,\n",
    "    warmup_ratio=0.1, eval_strategy=\"epoch\", save_strategy=\"epoch\", load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"macro_f1\", save_total_limit=1, fp16=torch.cuda.is_available(),\n",
    "    report_to=\"none\", logging_steps=20, seed=SEED)\n",
    "\n",
    "trainer = Trainer(model=model, args=args, train_dataset=train_ds, eval_dataset=val_ds,\n",
    "                  data_collator=DataCollatorForTokenClassification(tokenizer),\n",
    "                  compute_metrics=compute_metrics)\n",
    "trainer.train()"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "out = trainer.predict(val_ds)\n",
    "true, pred = to_tags(np.argmax(out.predictions, -1), out.label_ids)\n",
    "print(classification_report(true, pred, digits=3))\n",
    "trainer.save_model(OUT + \"-pt\"); tokenizer.save_pretrained(OUT + \"-pt\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Export to ONNX and quantise to 8-bit\n",
    "ONNX runs with `onnxruntime` alone, so the Vercel back end needs no PyTorch."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os, shutil\n",
    "from pathlib import Path\n",
    "from onnxruntime.quantization import QuantType, quantize_dynamic\n",
    "\n",
    "os.makedirs(OUT, exist_ok=True)\n",
    "model = trainer.model.to(\"cpu\").eval()\n",
    "sample = tokenizer([\"Python\", \"at\", \"Infosys\"], is_split_into_words=True, return_tensors=\"pt\")\n",
    "torch.onnx.export(\n",
    "    model, (sample[\"input_ids\"], sample[\"attention_mask\"]), f\"{OUT}/model-fp32.onnx\",\n",
    "    input_names=[\"input_ids\", \"attention_mask\"], output_names=[\"logits\"],\n",
    "    dynamic_axes={\"input_ids\": {0: \"batch\", 1: \"seq\"}, \"attention_mask\": {0: \"batch\", 1: \"seq\"},\n",
    "                  \"logits\": {0: \"batch\", 1: \"seq\"}},\n",
    "    opset_version=17)\n",
    "quantize_dynamic(f\"{OUT}/model-fp32.onnx\", f\"{OUT}/model.onnx\", weight_type=QuantType.QInt8)\n",
    "os.remove(f\"{OUT}/model-fp32.onnx\")\n",
    "\n",
    "# The app loads the fast tokenizer from tokenizer.json and the tag list from labels.json\n",
    "tokenizer.backend_tokenizer.save(f\"{OUT}/tokenizer.json\")\n",
    "json.dump(TAGS, open(f\"{OUT}/labels.json\", \"w\"))\n",
    "for f in sorted(Path(OUT).iterdir()):\n",
    "    print(f\"{f.name:16s} {f.stat().st_size / 1e6:6.1f} MB\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Check: the quantised ONNX model agrees with PyTorch on the validation set\n",
    "import onnxruntime as ort\n",
    "sess = ort.InferenceSession(f\"{OUT}/model.onnx\", providers=[\"CPUExecutionProvider\"])\n",
    "agree = total = 0\n",
    "for r in val_rows[:100]:\n",
    "    enc = tokenizer(r[\"words\"], is_split_into_words=True, truncation=True, max_length=512, return_tensors=\"np\")\n",
    "    onnx_pred = sess.run(None, {\"input_ids\": enc[\"input_ids\"].astype(\"int64\"),\n",
    "                                \"attention_mask\": enc[\"attention_mask\"].astype(\"int64\")})[0].argmax(-1)\n",
    "    with torch.no_grad():\n",
    "        pt_pred = model(input_ids=torch.tensor(enc[\"input_ids\"]),\n",
    "                        attention_mask=torch.tensor(enc[\"attention_mask\"])).logits.argmax(-1).numpy()\n",
    "    agree += (onnx_pred == pt_pred).sum(); total += onnx_pred.size\n",
    "print(f\"ONNX vs PyTorch token agreement: {agree / total:.2%}\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Upload to the Hugging Face Hub\n",
    "The back end downloads these three files on a cold start (set `MODEL_REPO` on Vercel)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from huggingface_hub import HfApi, login\n",
    "login()  # paste a write token from huggingface.co/settings/tokens\n",
    "api = HfApi()\n",
    "api.create_repo(HF_REPO, exist_ok=True)\n",
    "api.upload_folder(folder_path=OUT, repo_id=HF_REPO, allow_patterns=[\"model.onnx\", \"tokenizer.json\", \"labels.json\"])\n",
    "print(f\"https://huggingface.co/{HF_REPO}\")"
   ],
   "execution_count": null,
   "outputs": []
  }
 ],
